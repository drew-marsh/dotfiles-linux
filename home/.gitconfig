# Identity lives in ~/.gitconfig.local (created by bootstrap.sh, not tracked):
#   [user]
#     name = Your Name
#     email = you@example.com

[init]
	defaultBranch = main
[core]
	editor = vim
	autocrlf = input
	pager = less -FRX
[color]
	ui = auto
[pull]
	rebase = true
[push]
	default = current
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	autoSquash = true
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = default
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[help]
	autocorrect = prompt
[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch
	ci = commit
	amend = commit --amend --no-edit
	unstage = restore --staged
	last = log -1 HEAD --stat
	lg = log --graph --pretty=format:'%C(yellow)%h%C(reset) %C(blue)%ad%C(reset) %s%C(auto)%d %C(dim)<%an>%C(reset)' --date=short
	aliases = config --get-regexp ^alias\\.

[include]
	path = ~/.gitconfig.local
